# Copy this file to .env and adjust for your environment.
# The app reads these via os.getenv() with sensible defaults, so .env is optional locally.

# Path to the SQLite database file
PREBUNK_DB_PATH=./prebunk.db

# Path to the static content library
PREBUNK_CONTENT_PATH=./content.json

# Comma-separated list of allowed frontend origins for CORS.
# Use "*" during development; set explicit origins before a public launch, e.g.:
# PREBUNK_CORS_ORIGINS=https://prebunk.vercel.app,http://localhost:5173
PREBUNK_CORS_ORIGINS=*
